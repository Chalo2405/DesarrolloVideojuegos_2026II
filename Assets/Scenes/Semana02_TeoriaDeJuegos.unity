  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Una din\xE1mica emergente es la exploraci\xF3n libre, ya que el jugador
    puede combinar saltos, movimientos y capturas para llegar a lugares que no siempre
    siguen un \xFAnico camino.\n\nOtra din\xE1mica es experimentar con diferentes
    enemigos capturados para descubrir nuevas formas de superar obst\xE1culos o encontrar
    energilunas.\n\nEstas din\xE1micas no son reglas expl\xEDcitas porque el juego
    no obliga al jugador a realizarlas de una sola manera, sino que aparecen seg\xFAn
    c\xF3mo combine las mec\xE1nicas y explore cada escenario.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
